{
  "expo": {
    "name": "Kindred Log",
    "slug": "kindred-log",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kindred-log",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kindred.log"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      },
      "package": "com.kindred.log"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
