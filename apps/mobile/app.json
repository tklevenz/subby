{
  "expo": {
    "name": "Subby",
    "slug": "subby",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "subby",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "baby.subby.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0E1B3D"
      },
      "package": "baby.subby.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0E1B3D"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFC93C",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Subby uses the camera to scan the code shown on another phone when you add it to your family.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "de",
              "es",
              "fr",
              "nl",
              "it",
              "pt-BR"
            ],
            "android": [
              "en",
              "de",
              "es",
              "fr",
              "nl",
              "it",
              "pt-BR"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
