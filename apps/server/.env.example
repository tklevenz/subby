# Postgres connection string.
DATABASE_URL=postgres://kindred:kindred@localhost:54329/kindred
PORT=8787
# self: no limits, no push (self-hosting). hosted: the official Kindred Sync service.
MODE=self
# Encrypted photos: disk (BLOB_DIR, default ./data/blobs) or s3 (any S3-compatible storage).
BLOB_STORE=disk
BLOB_DIR=./data/blobs
# S3_BUCKET=kindred-blobs
# S3_REGION=us-east-1
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
