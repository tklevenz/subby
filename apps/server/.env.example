# Postgres connection string.
DATABASE_URL=postgres://subby:subby@localhost:54329/subby
PORT=8787
# self: no quotas or payment, no push (self-hosting). hosted: the official Subby Sync service.
MODE=self
# Background "sync now" pings via Firebase Cloud Messaging: on (fcm) for hosted, off (none) for self-hosted.
# fcm needs a Firebase service-account key, and reaches only app builds made with the same Firebase project.
# PUSH=none
# FCM_SERVICE_ACCOUNT=./secrets/firebase.json
# iOS push: an APNs key (.p8) with its key id and the team id.
# APNS_KEY=./secrets/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# Encrypted photos: disk (BLOB_DIR, default ./data/blobs) or s3 (any S3-compatible storage).
BLOB_STORE=disk
BLOB_DIR=./data/blobs
# S3_BUCKET=subby-blobs
# S3_REGION=us-east-1
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Hosted only: checking store purchases (PROJECT.md §3). Play needs a service account with access in the Play Console.
# GOOGLE_PLAY_SERVICE_ACCOUNT=./secrets/play.json
# APPLE_ALLOW_SANDBOX=1
# Per-client request limits (on by default). Behind a reverse proxy, name it so limits see the client's IP.
# RATE_LIMIT=off
# TRUST_PROXY=loopback
