# docker compose settings (copy to .env next to docker-compose.yml).

# Required. A long random string, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# For HTTPS (docker compose --profile https): a domain whose DNS points at this machine, ports 80 and 443 open.
# Also keep plain HTTP on this machine only, so nobody can go around the certificate.
# DOMAIN=sync.example.com
# HTTP_BIND=127.0.0.1
# Caddy forwards each client's IP; trust it from the compose network so request limits apply per client.
# TRUST_PROXY=uniquelocal

# Port for plain HTTP (without the https profile). The app's release builds only talk to HTTPS servers.
# HTTP_PORT=8787

# Photos go to the `blobs` volume by default. For S3-compatible storage instead:
# BLOB_STORE=s3
# S3_BUCKET=subby-blobs
# S3_REGION=us-east-1
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Push ("sync now" pings, so phones sync in the background right away) through Firebase Cloud Messaging. Only
# reaches app builds made with the same Firebase project: put that project's service-account key in ./secrets.
# PUSH=fcm
# FCM_SERVICE_ACCOUNT=/secrets/firebase.json

# Per-client request limits (generous; they stop scripts, not families). On by default.
# RATE_LIMIT=off
