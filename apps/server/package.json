{
  "name": "@kindred-log/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "serve:dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@kindred-log/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.11.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
