# /opt/subby/.env on the official server (chmod 600). Never commit the real one.

DOMAIN=sync.subby.baby
MODE=hosted
# A long random password: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Caddy reaches the server over the compose network (a private range), so request limits see client IPs.
TRUST_PROXY=uniquelocal

# Photos: Hetzner Object Storage.
BLOB_STORE=s3
S3_BUCKET=
S3_REGION=fsn1
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Nightly encrypted database backups (backup.sh, LAUNCH.md O2): a separate bucket with its own key, same endpoint.
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=

# Monitoring (monitor.sh, backup.sh; LAUNCH.md O3): Healthchecks.io ping URLs. Server: every 5 minutes (period 5 min,
# grace 10 min). Backup: daily (period 1 day, grace 2 hours).
HC_PING_SERVER=
HC_PING_BACKUP=
# Optional: monitor.sh's daily summary (totals and the day's requests; no ids). Period 1 day, grace 1 hour. Without it
# the summary only goes to /opt/subby/stats.log.
HC_PING_SUMMARY=

# Push: the Firebase service-account key in /opt/subby/secrets/firebase.json (same Firebase project as the app).
# Until it's there, PUSH=none (phones then sync on open and every ~15 min in the background).
PUSH=fcm
FCM_SERVICE_ACCOUNT=/secrets/firebase.json
# iOS push: the APNs key in /opt/subby/secrets/apns.p8 (developer account → Keys, "Apple Push Notifications
# service", Sandbox & Production), its key id and the team id. Without it, iPhones sync on open and when iOS allows.
# APNS_KEY=/secrets/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=L33LRKM2NX

# Store purchases (LAUNCH.md A3, after D7). Without these, store purchases are refused; trials work.
# GOOGLE_PLAY_SERVICE_ACCOUNT=/secrets/play.json
# GOOGLE_PLAY_PACKAGE=baby.subby.app
# APPLE_BUNDLE_ID=baby.subby.app

# Set by deploy.sh: the image the server runs.
# IMAGE_TAG=
